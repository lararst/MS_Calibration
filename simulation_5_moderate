###
### This program runs the assessment of moderate calibration in the small sample simulation
###

library(foreach)
library(doParallel)

source("/z_functions.R")
source("/z_functions_true_transition_probs.R")
source("/z_load_packages.R")

### Define time at which risks will be generated and  calibration will be assessed
t.eval <- round(365.25*7)

#moderate calibration function
modCal <- function(scen, n.cohort, n.pctls){
  
  safe_calc <- function(expr) {
    tryCatch(expr, error = function(e) return(NULL))
  }
  
  ### Create list to store calibration of each estimates
  blr_list <- vector("list", 3)
  mlr_list <- vector("list", 3)
  pv_list  <- vector("list", 3)
  
  success <- TRUE
  
  ###
  ### Run the simulation loop
  ###
  
  #fail counts for every type of transition probability and every method
  fail_count <- 0
  fail_count_pv_m1 <- 0
  fail_count_pv_m2 <- 0
  fail_count_pv_m3 <- 0
  fail_count_blr_m1 <- 0
  fail_count_blr_m2 <- 0
  fail_count_blr_m3 <- 0
  fail_count_mlr_m1 <- 0
  fail_count_mlr_m2 <- 0
  fail_count_mlr_m3 <- 0
  
  ### Choose patids at random
  patids.vec <- sample((1:1000000), n.cohort, replace = FALSE)
  
  ### Extract individuals
  data.mstate.reduc <- data.mstate[data.mstate$id %in% patids.vec, ]
  data.raw.reduc <- data.raw[data.raw$id %in% patids.vec, ]
  
  ###
  ### Calculate calibration for each type of predicted risk
  ###
  
  for (i in 1:3){
    
    ### Extract predicted risks
    tp.pred[[i]]$id <- 1:nrow(tp.pred[[i]])
    tp.pred.reduc <- tp.pred[[i]][tp.pred[[i]]$id %in% patids.vec, ] |>
      dplyr::select(!id)
    
    if (scen == "C1"){
      
      ###
      ### Estimate moderate calibration with BLR-IPCW
      calib.mod <- safe_calc(
        calib_msm(data_ms = data.mstate.reduc,
                  data_raw = data.raw.reduc,
                  j=1,s=0,t=t.eval,
                  tp_pred = tp.pred.reduc,
                  calib_type="blr",
                  curve_type="rcs",
                  rcs_nk=4,
                  assess_moderate=TRUE,
                  assess_mean=FALSE)$plotdata
      )
      if (is.null(calib.mod)) {
        success <- FALSE
        if (i == 1) fail_count_blr_m1 <- 1
        if (i == 2) fail_count_blr_m2 <- 1
        if (i == 3) fail_count_blr_m3 <- 1
      } else {
        blr_list[[i]] <- calib.mod
      }
      
      ###
      ### Estimate moderate calibration with MLR-IPCW
      calib.mod <- safe_calc(
        calib_msm(data_ms = data.mstate.reduc,
                  data_raw = data.raw.reduc,
                  j=1,s=0,t=t.eval,
                  tp_pred = tp.pred.reduc,
                  calib_type="mlr",
                  assess_moderate=TRUE,
                  assess_mean=FALSE)$plotdata
      )
      
      if (is.null(calib.mod)) {
        success <- FALSE
        if (i == 1) fail_count_mlr_m1 <- 1
        if (i == 2) fail_count_mlr_m2 <- 1
        if (i == 3) fail_count_mlr_m3 <- 1
      } else {
        mlr_list[[i]]<- calib.mod
      }
      
      ###
      ### Estimate moderate calibration with pseudo-values
      calib.mod <- safe_calc(
        calib_msm(data_ms = data.mstate.reduc,
                  data_raw = data.raw.reduc,
                  j=1,s=0,t=t.eval,
                  tp_pred = tp.pred.reduc,
                  calib_type="pv",
                  curve_type="rcs",
                  rcs_nk=4,
                  assess_moderate=TRUE,
                  assess_mean=FALSE)$plotdata
      )
      
      if (is.null(calib.mod)) {
        success <- FALSE
        if (i == 1) fail_count_pv_m1 <- 1
        if (i == 2) fail_count_pv_m2 <- 1
        if (i == 3) fail_count_pv_m3 <- 1
      } else {
        pv_list[[i]] <- calib.mod
      }
      
    } else if (scen %in% c("C2", "C3","C4","C5", "C6","C7")){
      
      ###
      ### Estimate moderate calibration with BLR-IPCW
      calib.mod <- safe_calc(
        calib_msm(data_ms = data.mstate.reduc,
                  data_raw = data.raw.reduc,
                  j=1,s=0,t=t.eval,
                  tp_pred = tp.pred.reduc,
                  calib_type="blr",
                  curve_type="rcs",
                  rcs_nk=4,
                  w_covs=c("x12", "x13", "x15", "x24", "x25", "x34", "x35", "x45"),
                  assess_moderate=TRUE,
                  assess_mean=FALSE)$plotdata
      )
      if (is.null(calib.mod)) {
        success <- FALSE
        if (i == 1) fail_count_blr_m1 <- 1
        if (i == 2) fail_count_blr_m2 <- 1
        if (i == 3) fail_count_blr_m3 <- 1
      } else {
        blr_list[[i]] <- calib.mod
      }
      
      ###
      ### Estimate moderate calibration with MLR-IPCW
      calib.mod <- safe_calc(
        calib_msm(data_ms = data.mstate.reduc,
                  data_raw = data.raw.reduc,
                  j=1,s=0,t=t.eval,
                  tp_pred = tp.pred.reduc,
                  calib_type="mlr",
                  w_covs=c("x12", "x13", "x15", "x24", "x25", "x34", "x35", "x45"),
                  assess_moderate=TRUE,
                  assess_mean=FALSE)$plotdata
      )
      if (is.null(calib.mod)) {
        success <- FALSE
        if (i == 1) fail_count_mlr_m1 <- 1
        if (i == 2) fail_count_mlr_m2 <- 1
        if (i == 3) fail_count_mlr_m3 <- 1
      } else {
        mlr_list[[i]] <- calib.mod
      }
      
      ###
      ### Estimate moderate calibration with pseudo-values
      calib.mod <- safe_calc(
        calib_msm(data_ms = data.mstate.reduc,
                  data_raw = data.raw.reduc,
                  j=1,s=0,t=t.eval,
                  tp_pred = tp.pred.reduc,
                  calib_type="pv",
                  curve_type="rcs",
                  rcs_nk=4,
                  pv_n_pctls = n.pctls,
                  assess_moderate=TRUE,
                  assess_mean=FALSE)$plotdata
      )
      if (is.null(calib.mod)) {
        success <- FALSE
        if (i == 1) fail_count_pv_m1 <- 1
        if (i == 2) fail_count_pv_m2 <- 1
        if (i == 3) fail_count_pv_m3 <- 1
      } else {
        pv_list[[i]] <- calib.mod
      }
    }
  }
  
  if (!success) {
    fail_count <- fail_count + 1
  }
  
  return(list(
    blr = blr_list,
    mlr = mlr_list,
    pv  = pv_list,
    fail_count,
    fail_count_pv_m1,
    fail_count_pv_m2,
    fail_count_pv_m3,
    fail_count_blr_m1,
    fail_count_blr_m2,
    fail_count_blr_m3,
    fail_count_mlr_m1,
    fail_count_mlr_m2,
    fail_count_mlr_m3
  ))
}

# settings
n.cohort <- 700 #400/500
n.pctls  <- 10
scen     <- "C1" #"C2"/"C3"/"C4"/"C5"/"C6"/"C7"
calib.blr.mod.list <- vector("list", 1000)
calib.mlr.mod.list <- vector("list", 1000)
calib.pv.mod.list  <- vector("list", 1000)
fail_count <- 0
fail_count_pv_m1 <- 0
fail_count_pv_m2 <- 0
fail_count_pv_m3 <- 0
fail_count_blr_m1 <- 0
fail_count_blr_m2 <- 0
fail_count_blr_m3 <- 0
fail_count_mlr_m1 <- 0
fail_count_mlr_m2 <- 0
fail_count_mlr_m3 <- 0

cl = parallel::makeCluster(10)
clusterSetRNGStream(cl, iseed = 1)
doParallel::registerDoParallel(cl)

clusterEvalQ(cl, {
  
  # Source all functions ONCE per worker
  source("/z_functions.R")
  source("/z_functions_true_transition_probs.R")
  source("/z_load_packages.R")
  
  # Load big dataset ONCE per worker
  scen_local <- "C1" #"C2"/"C3"/"C4"/"C5"/"C6"/"C7"
  load(paste0("/small_sample_prep_data_", scen_local, ".RData"))
  NULL
})
### Export specific objects used inside meanCal
clusterExport(cl, c("modCal","t.eval", "n.cohort", "n.pctls", "scen"))

results<- foreach(sim = 1:1000) %dopar% {
  modCal(scen, n.cohort, n.pctls)
}

for (sim in 1:1000) {
  calib.blr.mod.list[[sim]] <- results[[sim]]$blr
  calib.mlr.mod.list[[sim]] <- results[[sim]]$mlr
  calib.pv.mod.list[[sim]]  <- results[[sim]]$pv
  fail_count <- fail_count + results[[sim]]$fail_count
  fail_count_pv_m1 <- fail_count_pv_m1 + results[[sim]]$fail_count_pv_m1
  fail_count_pv_m2 <- fail_count_pv_m2 + results[[sim]]$fail_count_pv_m2
  fail_count_pv_m3 <- fail_count_pv_m3 + results[[sim]]$fail_count_pv_m3
  fail_count_blr_m1 <- fail_count_blr_m1 + results[[sim]]$fail_count_blr_m1
  fail_count_blr_m2 <- fail_count_blr_m2 + results[[sim]]$fail_count_blr_m2
  fail_count_blr_m3 <- fail_count_blr_m3 + results[[sim]]$fail_count_blr_m3
  fail_count_mlr_m1 <- fail_count_mlr_m1 + results[[sim]]$fail_count_mlr_m1
  fail_count_mlr_m2 <- fail_count_mlr_m2 + results[[sim]]$fail_count_mlr_m2
  fail_count_mlr_m3 <- fail_count_mlr_m3 + results[[sim]]$fail_count_mlr_m3
}

save(
  list = c("calib.blr.mod.list", "calib.mlr.mod.list", "calib.pv.mod.list",
           "scen", "n.cohort", "n.pctls", "fail_count","fail_count_blr_m1","fail_count_blr_m2","fail_count_blr_m3",
           "fail_count_mlr_m1","fail_count_mlr_m2","fail_count_mlr_m3",
           "fail_count_pv_m1","fail_count_pv_m2","fail_count_pv_m3"),
  file = paste0("/output/small_sample_moderate_analysis_",
                scen, "_n", n.cohort, "_npctls", n.pctls,".RData")
)



